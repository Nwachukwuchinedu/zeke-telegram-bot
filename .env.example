# Telegram Bot Token from @BotFather
BOT_TOKEN=your_bot_token_here

# MongoDB Connection String (from MongoDB Atlas or local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/telegram_bot?retryWrites=true&w=majority

# Target Community/Group ID (optional if bot creates links dynamically inside the group, but recommended for DM /invite support)
GROUP_CHAT_ID=
